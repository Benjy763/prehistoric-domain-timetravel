{
  "name": "prehistoric-domain-timetravel",
  "version": "1.0.0",
  "description": "Globe 3D interactif pour explorer les contenus préhistoriques",
  "main": "index.html",
  "scripts": {
    "dev": "python3 -m http.server 8000",
    "build": "echo 'Build completed - ready for deployment'",
    "deploy": "echo 'Upload files to Hostinger server'",
    "init": "node scripts/import-new-contents.js --all",
    "sync": "node scripts/import-new-contents.js",
    "sync:dry": "node scripts/import-new-contents.js --dry-run",
    "add": "node scripts/add-content-by-slug.js",
    "validate": "node scripts/validate-content-data.js",
    "validate:tags": "node scripts/validate-free-tags.js",
    "validate:tags:errors": "node scripts/validate-free-tags.js --only-errors",
    "help": "bash scripts/help.sh"
  },
  "keywords": [
    "prehistoric",
    "globe",
    "3d",
    "webflow",
    "threejs"
  ],
